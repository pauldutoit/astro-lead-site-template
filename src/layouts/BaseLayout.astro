---
import siteConfig from '../data/site.config.json';

interface Props {
  title: string;
  description: string;
  indexable?: boolean;
  canonicalPath?: string;
}

const { title, description, indexable = true, canonicalPath = Astro.url.pathname } = Astro.props;
const canonicalUrl = new URL(canonicalPath, `https://${siteConfig.domain}`).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,follow'} />
    <meta name="theme-color" content={siteConfig.themeColor} />
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/">{siteConfig.siteName}</a>
      <a class="phone" href={`tel:${siteConfig.phone.replace(/\s+/g, '')}`}>{siteConfig.phone}</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>{siteConfig.legalName} &middot; {siteConfig.legalAddress}</p>
      <p><a href="/mentions-legales">Legal notice</a> &middot; <a href="/politique-de-confidentialite">Privacy policy</a></p>
    </footer>
  </body>
</html>

<style is:global define:vars={{ themeColor: siteConfig.themeColor }}>
  :root {
    --color-primary: var(--themeColor);
    --color-text: #1a1a1a;
    --color-bg: #ffffff;
    --color-muted: #6b6b6b;
    font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; color: var(--color-text); background: var(--color-bg); line-height: 1.5; }
  .site-header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; border-bottom: 1px solid #eee; }
  .logo { font-weight: 700; text-decoration: none; color: var(--color-primary); }
  .phone { font-weight: 600; text-decoration: none; color: var(--color-primary); }
  main { max-width: 900px; margin: 0 auto; padding: 1.5rem; }
  .site-footer { text-align: center; padding: 2rem 1rem; color: var(--color-muted); font-size: 0.85rem; }
</style>
